<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 前台服务常驻通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 引导用户把本应用加入电池优化白名单 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 保活：开机后与覆盖安装后自动恢复常驻服务 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      「护眼休息」与「最低亮度守护」带来的四项权限（2026-11-07）。
      每一项都有明确读取者，且都在首页有状态行 + 授权入口：
        WAKE_LOCK           浮窗期间持有屏幕常亮锁（FLAG_KEEP_SCREEN_ON 对无障碍浮窗无效）
        VIBRATE             休息结束的两下短震（install-time，不需要授权行）
        WRITE_SETTINGS      最低亮度守护的直写通道；没有它还能走 Shizuku，所以不是硬门禁
        READ_PHONE_STATE    浮窗期间来电立即撤窗；没有它降级为窗口名检测
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
      刻意不申请的权限（2026-11-06 清理）：
      QUERY_ALL_PACKAGES     —— 应用白名单已删除，不再枚举已安装应用。
      PACKAGE_USAGE_STATS    —— 自动显隐方案已废弃（五条路实测失败），不再读前台应用。
    两者都曾是"只对某些应用生效"那套设计的基础，那套设计连同白名单一起删掉了。
    -->

    <!-- 刻意不申请 INTERNET：全部本地运行，无上报、无后端。 -->

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SwissKnife">

        <!-- excludeFromRecents：本应用不在「最近任务」里露面。
             这个属性只对**任务栈的根 Activity** 生效，所以加在这里一个就够，
             不必给 ForceScrollActivity / Saver4GActivity 也加（它们都跑在同一个任务里）。
             理由：这是个挂在后台起作用的小工具，留在最近任务里只是噪音；
             和 ESR 的做法一致（那边也是只在 launcher Activity 上加这一条）。
             注意：更新前就已经在最近任务里的那条记录不会消失，重启应用进程后才彻底干净。 -->
        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ShortcutToggleActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".ui.ForceScrollActivity"
            android:exported="false"
            android:label="@string/feature_force_scroll" />

        <!-- 「极致省电」功能页：省电模式期间把默认卡从 5G 优先降到 4G 优先。
             不申请任何新权限：检测省电模式靠公开的 PowerManager + 系统广播，
             改网络制式走 Shizuku（shell 身份执行 cmd phone）。 -->
        <activity
            android:name=".ui.Saver4GActivity"
            android:exported="false"
            android:label="@string/feature_saver_4g" />

        <!-- 「护眼休息」功能页：计时状态 + 调参（阈值）。开关在首页。 -->
        <activity
            android:name=".ui.EyeBreakActivity"
            android:exported="false"
            android:label="@string/feature_eye_break" />

        <!-- 「最低亮度守护」功能页：亮度状态 + 调参（下限）。开关在首页。
             注意：本功能不依赖无障碍服务，别顺手给它加 requiredAuth。 -->
        <activity
            android:name=".ui.BrightGuardActivity"
            android:exported="false"
            android:label="@string/feature_bright_guard" />


        <!-- 保活第 1/3 层：常驻前台服务。
             承载悬浮球的无障碍服务跑在普通应用进程里，没有前台服务时会被降为 cached 并冻结，
             球随之静默消失。specialUse 是唯一贴切的类型（不是定位、通话、媒体这些既有分类），
             subtype 说明必须写清用途，否则 Play 审核不过。 -->
        <service
            android:name=".keepalive.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the accessibility overlay ball resident so it stays clickable. No data collection, no network access." />
        </service>

        <!-- 保活第 5 层：开机与覆盖安装后重新拉起常驻服务。
             只注册 BOOT_COMPLETED / MY_PACKAGE_REPLACED，不注册 LOCKED_BOOT_COMPLETED
             （那条需要 directBootAware，且解锁前读不到功能开关，起了也是空转）。 -->
        <receiver
            android:name=".keepalive.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Shizuku：用于向本应用授予 shell 身份 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 前台应用监听 + 容器可滚状态判定 -->
        <service
            android:name=".access.ForegroundWatcherService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

    </application>

</manifest>
