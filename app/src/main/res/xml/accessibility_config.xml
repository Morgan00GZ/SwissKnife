<?xml version="1.0" encoding="utf-8"?>
<!--
  只订阅 TYPE_WINDOW_STATE_CHANGED：前台应用切换。

  为什么需要 flagRetrieveInteractiveWindows / canRetrieveWindowContent：
  事件自带的包名不等于当前前台应用。实测抖音启动瞬间会连续抛出多个窗口事件，
  其中夹着系统过渡窗口（包名不是抖音），单看事件包名会导致悬浮球被反复显示/移除，
  最后一次若不是白名单应用，球就消失了。改为读窗口列表取图层最高的应用窗口才准确。
  注意：这里只读包名用于判断，不读取任何屏幕内容或输入。

  为什么不订阅触摸与滚动事件：
  实测收不到 TYPE_TOUCH_INTERACTION_*（需开触摸探索模式，全局单击会变双击），
  抖音播放器也不上报 TYPE_VIEW_SCROLLED（自绘控件）。
  既然"用户滑了但没滑成"无法观测，就不订阅这些事件。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged|typeWindowContentChanged|typeViewClicked"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_desc"
    android:notificationTimeout="100"
    android:settingsActivity="com.swissknife.MainActivity" />
