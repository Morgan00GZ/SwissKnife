    <string name="eb_phase_gaze">注视计时</string>
    <string name="eb_phase_screen">亮屏计时</string>
    <string name="eb_phase_no_gaze">未检测到注视，已暂停</string>
    <string name="eb_phase_screen_off">熄屏暂停</string>
    <string name="eb_phase_stopped">未计时（功能关闭）</string>
