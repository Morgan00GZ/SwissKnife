    <string name="sv_cell_inactive">未生效</string>
    <string name="sv_allowed">允许制式</string>
    <string name="sv_allowed_has_nr">含 5G</string>
    <string name="sv_allowed_no_nr">已限 4G</string>
    <string name="sv_actual">实测制式</string>
