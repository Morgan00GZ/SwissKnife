    <!-- 功能：强制滑动 -->
    <string name="feature_force_scroll">强制滑动</string>
    <string name="feature_force_scroll_desc">广告倒计时内也能正常上滑</string>
    <string name="feature_coming">更多功能，以后再加</string>

    <string name="fs_desc">部分应用在广告倒计时期间会锁住屏幕滑动，手指上滑没有反应，只能干等。开启后屏幕边缘会出现一个半透明圆点，滑不动时点一下就能翻过去。</string>
    <string name="fs_status">运行状态</string>
    <string name="fs_running">运行中</string>
    <string name="fs_paused">已暂停</string>
    <string name="fs_waiting">等待授权</string>
    <string name="fs_count">今日补滑</string>
    <string name="fs_count_unit">%1$d 次</string>
    <string name="sc_toggle_short">开关悬浮球</string>
    <string name="sc_toggle_long">一键开关「强制滑动」</string>
    <string name="sc_toast_on">强制滑动：已开启</string>
    <string name="sc_toast_off">强制滑动：已关闭</string>
    <string name="fs_rule_title">怎么用</string>
    <string name="fs_rule_1">1. 打开总开关，屏幕边缘出现一个半透明圆球</string>
    <!-- 旧文案说"球变绿表示已触发"，但实现上成功时没有任何反馈（见 ForegroundWatcherService.fireScroll），
         只有失败才会把文字变橙 400 毫秒。说明必须跟着实现走，否则用户会一直等那个不存在的绿。 -->
    <string name="fs_rule_2">2. 单击圆球：立刻补一次滑动。成功没有任何提示，失败时球上的文字变橙 400 毫秒</string>
    <string name="fs_rule_3">3. 拖动圆球：可以放到任意顺手的位置，松手后自动吸附屏幕边缘</string>
    <!-- 旧文案是"长按 1 秒：收起，再次打开本应用即恢复"，两处都不对：
         实际阈值 600 毫秒（ForegroundWatcherService.LONG_PRESS_MS），且长按会连同功能开关一起关掉，
         重新打开应用不会自动恢复（那条自动恢复逻辑已刻意删除）。 -->
    <string name="fs_rule_4">4. 长按圆球 600 毫秒：关闭功能并收起圆球，与关掉总开关等效</string>
    <string name="fs_rule_5">5. 关闭总开关：圆球消失，功能完全停止</string>
    <string name="fs_rule_6">关于显隐：系统无法可靠判断你当前打开了哪个应用，所以圆球不做自动显示与隐藏，完全由总开关和长按控制。球一旦出现就一直在，不影响你在任何应用里使用。</string>

    <!-- 功能：极致省电（省电模式期间把 5G 降到 4G） -->
    <string name="feature_saver_4g">极致省电</string>
    <string name="feature_saver_4g_desc">省电模式下自动把 5G 降到 4G</string>

    <string name="sv_desc">省电模式本来就是"电量紧张"的信号，而 5G 是耗电大头。开启后，只要系统进入省电模式，本应用就把默认卡允许的网络制式从「含 5G」改成「只到 4G」；退出省电再写回进入前的原值。</string>
